# Cloned test repos (populated by checkout.py)
repos/

# Generated results (outputs, full baselines, review packets)
results/

# Generated verification reports (regenerated by validate/*.py runs)
reports/

# Analyzer capability_mode + scratch outputs (default analyze_*.py --analysis-dir target)
/analysis/

# Temp/output from integration tests
test_datasheets_out/
test_bom_out/

# Downloaded datasheets (tracked via reference/datasheets_verification.json)
reference/datasheets_verification/

# Not tracked — per-machine instructions and inter-agent files
CLAUDE.md
/TODO-*
/TEST-*
/LOG-*
.claude/
.superpowers/
docs/

# Retired files preserved on-disk (kidoc skill removal 2026-05-19, mirrors kicad-happy 6b6e622)
old/

# Python
__pycache__/
*.pyc

# Stray backups from re-seed / migration tools
*.bak

# Editor
*.swp
*.swo
*~

# Python venv (session-local)
.venv/

# Session-local logs (e.g., logs/rc2_vs_rc3_gate.log)
/logs/
