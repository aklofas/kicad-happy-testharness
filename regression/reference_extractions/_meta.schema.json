{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kicad-happy.local/harness/_meta.schema.json",
  "title": "Gold-set MPN metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mpn", "mpn_slug", "pdf_sha256", "pdf_filename",
    "schema_version_at_curation", "extractor_schema_version_at_curation",
    "curated_at", "curated_from", "history"
  ],
  "properties": {
    "mpn": {"type": "string", "minLength": 1},
    "mpn_slug": {"type": "string", "pattern": "^[a-z0-9_\\-.]+$"},
    "pdf_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pdf_filename": {"type": "string", "minLength": 1},
    "schema_version_at_curation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "categories"],
      "properties": {
        "base": {"type": "string", "pattern": "^\\d+\\.\\d+$"},
        "categories": {
          "type": "object",
          "additionalProperties": {"type": "string", "pattern": "^\\d+\\.\\d+$"}
        }
      }
    },
    "extractor_schema_version_at_curation": {"type": "string", "pattern": "^\\d+\\.\\d+$"},
    "curated_at": {"type": "string", "format": "date-time"},
    "curated_from": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cache_path", "gate_run_id", "gate_quality_score",
        "sanity_vector_path", "sanity_vector_pass", "sanity_vector_field_count"
      ],
      "properties": {
        "cache_path": {"type": "string"},
        "gate_run_id": {"type": ["string", "null"]},
        "gate_quality_score": {"type": "integer", "minimum": 0, "maximum": 100},
        "sanity_vector_path": {"type": "string"},
        "sanity_vector_pass": {"type": "boolean"},
        "sanity_vector_field_count": {"type": "integer", "minimum": 0}
      }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event", "at", "pdf_sha256", "schema_version", "gate_quality_score"],
        "properties": {
          "event": {"enum": ["initial", "update", "pdf_sha_change", "recurate_major_bump"]},
          "at": {"type": "string", "format": "date-time"},
          "pdf_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "schema_version": {
            "type": "object",
            "additionalProperties": false,
            "required": ["base", "categories"],
            "properties": {
              "base": {"type": "string", "pattern": "^\\d+\\.\\d+$"},
              "categories": {
                "type": "object",
                "additionalProperties": {"type": "string", "pattern": "^\\d+\\.\\d+$"}
              }
            }
          },
          "gate_quality_score": {"type": "integer", "minimum": 0, "maximum": 100},
          "from_schema_version": {
            "type": "object",
            "additionalProperties": false,
            "required": ["base", "categories"],
            "properties": {
              "base": {"type": "string", "pattern": "^\\d+\\.\\d+$"},
              "categories": {
                "type": "object",
                "additionalProperties": {"type": "string", "pattern": "^\\d+\\.\\d+$"}
              }
            }
          }
        }
      }
    }
  }
}
