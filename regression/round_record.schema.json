{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kicad-happy-testharness/round_record.schema.json",
  "title": "v3 per-round handoff record (spec §9)",
  "oneOf": [{"$ref": "#/$defs/request"}, {"$ref": "#/$defs/response"}],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "skill_path": {"type": "string", "pattern": "^skills/[A-Za-z0-9_./-]+\\.py$"},
    "relocation": {
      "type": "object", "additionalProperties": false,
      "required": ["symbol", "old_owner", "new_owner", "new_name", "facade_until"],
      "properties": {
        "symbol": {"type": "string", "minLength": 1},
        "old_owner": {"$ref": "#/$defs/skill_path"},
        "new_owner": {"$ref": "#/$defs/skill_path"},
        "new_name": {"type": "string", "minLength": 1},
        "facade_until": {"type": ["string", "null"], "pattern": "^r[0-9]{2,3}(-[a-z0-9-]+)?$"}
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["record_version", "round_id", "baseline_sha", "candidate_sha", "kind",
                   "relocations", "profiles", "budget", "old_artifact_checks", "relock"],
      "properties": {
        "record_version": {"const": 1},
        "round_id": {"type": "string", "pattern": "^r[0-9]{2,3}-[a-z0-9-]+$"},
        "baseline_sha": {"$ref": "#/$defs/sha"},
        "candidate_sha": {"$ref": "#/$defs/sha"},
        "kind": {"enum": ["structural", "output-changing", "relock"]},
        "relocations": {"type": "array", "items": {"$ref": "#/$defs/relocation"}},
        "profiles": {"type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["standard", "full-chain", "hierarchy", "spice-offline", "long-tail"]}},
        "budget": {"type": ["string", "null"], "pattern": "^regression/budgets/[a-z0-9-]+\\.json$"},
        "old_artifact_checks": {"type": "array", "items": {"type": "string"}},
        "expected": {"type": "object"},
        "relock": {"type": "boolean"},
        "removed": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["symbol", "harness_refs"],
          "properties": {"symbol": {"type": "string", "minLength": 1},
                         "harness_refs": {"type": "array", "items": {"type": "string"}}}}},
        "known_defects_deferred": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["file", "line", "summary", "fix_round"],
          "properties": {"file": {"$ref": "#/$defs/skill_path"},
                         "line": {"type": "integer", "minimum": 1},
                         "summary": {"type": "string"},
                         "fix_round": {"type": ["string", "null"], "pattern": "^r[0-9]{2,3}(-[a-z0-9-]+)?$"},
                         "decision": {"type": "string"}}}},
        "expected_sidecar_changes": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["file", "leaf", "reason"],
          "properties": {"file": {"type": "string"}, "leaf": {"type": "string", "pattern": "^/"},
                         "reason": {"type": "string"}}}},
        "product_evidence": {"type": "object", "additionalProperties": false,
          "required": ["quick_json", "schema_identical", "pinned_harness"],
          "properties": {"quick_json": {"type": "string"}, "schema_identical": {"type": "boolean"},
                         "pinned_harness": {"type": "string"}}}
      }
    },
    "side_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["record_version", "round_id", "harness_sha", "run_ids", "normalization_policy",
                   "executed", "census", "verdicts", "deltas", "relocation_status",
                   "ledger_hits", "filings", "evidence", "verdict"],
      "properties": {
        "record_version": {"const": 1},
        "round_id": {"type": "string", "pattern": "^r[0-9]{2,3}-[a-z0-9-]+$"},
        "harness_sha": {"$ref": "#/$defs/sha"},
        "run_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 8}},
        "normalization_policy": {"type": "string", "pattern": "^volatile-leaves-v[0-9]+$"},
        "executed": {"type": "object", "additionalProperties": false,
          "required": ["units", "pairs_by_analyzer", "checks", "tests"],
          "properties": {
            "units": {"type": "integer", "minimum": 0},
            "pairs_by_analyzer": {"$ref": "#/$defs/side_counts"},
            "checks": {"type": "integer", "minimum": 0},
            "tests": {"type": "object", "additionalProperties": false,
              "required": ["collected", "passed", "skipped", "errors"],
              "properties": {"collected": {"type": "integer"}, "passed": {"type": "integer"},
                             "skipped": {"type": "integer"}, "errors": {"type": "integer"}}}}},
        "census": {"type": "object", "additionalProperties": false,
          "required": ["expected", "executed", "skip_reasons"],
          "properties": {"expected": {"$ref": "#/$defs/side_counts"},
                         "executed": {"$ref": "#/$defs/side_counts"},
                         "skip_reasons": {"$ref": "#/$defs/side_counts"}}},
        "verdicts": {"type": "object", "additionalProperties": false,
          "required": ["raw", "strict", "budgeted", "findings_summary"],
          "properties": {
            "raw": {"enum": ["clean", "deltas", "error"]},
            "strict": {"enum": ["clean", "deltas", "error"]},
            "budgeted": {"enum": ["clean", "residuals", "over_budget", "error", "n/a"]},
            "findings_summary": {"enum": ["strict_clean", "clean", "not_clean"]}}},
        "deltas": {"type": "object", "additionalProperties": false,
          "required": ["complete_report", "by_class", "residuals"],
          "properties": {
            "complete_report": {"type": ["string", "null"]},
            "by_class": {"type": "object"},
            "residuals": {"type": "integer", "minimum": 0}},
          "if": {"properties": {"residuals": {"minimum": 1}}},
          "then": {"properties": {"complete_report": {"type": "string", "minLength": 1}}}},
        "relocation_status": {"type": "object", "additionalProperties": false,
          "required": ["migrated", "pending", "facade_still_used"],
          "properties": {"migrated": {"type": "integer"}, "pending": {"type": "integer"},
                         "facade_still_used": {"type": "array", "items": {"type": "string"}}}},
        "ledger_hits": {"type": "array", "items": {"type": "string"}},
        "filings": {"type": "array", "items": {"type": "string", "pattern": "^(KH|TH)-[0-9]{3}$"}},
        "evidence": {"type": "object", "required": ["manifest", "rollup"],
          "properties": {"manifest": {"type": "string"}, "rollup": {"type": "string"},
                         "adjudication": {"type": ["string", "null"]}}},
        "verdict": {"enum": ["accept", "reject", "accept-with-filings"]},
        "apply_map_result": {"type": "object", "additionalProperties": false,
          "required": ["sites_migrated", "files"],
          "properties": {"sites_migrated": {"type": "integer", "minimum": 0},
                         "files": {"type": "array", "items": {"type": "string"}}}},
        "accept_baseline_diff": {"type": ["string", "null"]},
        "scan_coverage_verdict": {"enum": ["pass", "fail", "not_run"]},
        "budget_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
