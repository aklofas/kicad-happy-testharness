(kicad_pcb (version 20240108) (generator "pcbnew")
(general (thickness 1.6))
(layers (0 "F.Cu" signal) (31 "B.Cu" signal) (38 "B.Mask" user) (39 "F.Mask" user) (44 "Edge.Cuts" user))
(setup (pad_to_mask_clearance 0))
(net 0 "")
(net 1 "CLK")
(net 2 "GND")
(net 3 "SIG2")
(net 4 "+3V3")
(net 5 "MCU3v3")
(net 6 "+5V")
(gr_rect (start 0 0) (end 50 50) (stroke (width 0.05) (type default)) (fill none) (layer "Edge.Cuts"))
(segment (start 2 10) (end 18 10) (width 0.2) (layer "F.Cu") (net 1))
(zone (net 4) (net_name "+3V3") (layer "B.Cu") (hatch edge 0.5) (connect_pads (clearance 0.2)) (min_thickness 0.25) (fill yes (thermal_gap 0.5) (thermal_bridge_width 0.5)) (polygon (pts (xy 0 5) (xy 9.5 5) (xy 9.5 15) (xy 0 15))) (filled_polygon (layer "B.Cu") (pts (xy 0 5) (xy 9.5 5) (xy 9.5 15) (xy 0 15))))
(zone (net 6) (net_name "+5V") (layer "B.Cu") (hatch edge 0.5) (connect_pads (clearance 0.2)) (min_thickness 0.25) (fill yes (thermal_gap 0.5) (thermal_bridge_width 0.5)) (polygon (pts (xy 10.5 5) (xy 20 5) (xy 20 15) (xy 10.5 15))) (filled_polygon (layer "B.Cu") (pts (xy 10.5 5) (xy 20 5) (xy 20 15) (xy 10.5 15))))
)
